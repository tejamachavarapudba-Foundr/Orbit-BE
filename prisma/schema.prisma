generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  passwordHash      String
  refreshHash       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isBanned          Boolean          @default(false)
  role              UserRole         @default(USER)
  resetToken        String?          @unique
  resetTokenExpires DateTime?
  emailVerified            Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?
  phoneNumber              String?   @unique
  phoneVerified            Boolean   @default(false)
  auditLogs         AuditLog[]
  connectedGoogleAccount ConnectedGoogleAccount?
  notifications     Notification[]
  profile           Profile?
  savedStartups     SavedStartup[]
  likedStartups     StartupLike[]
  viewedStartups    StartupView[]
}

model Profile {
  id                         String                  @id
  fullName                   String                  @default("")
  headline                   String                  @default("")
  bio                        String                  @default("")
  role                       MemberRole              @default(other)
  location                   String                  @default("")
  language                   String[]
  fcmTokens                  String[]
  company                    String                  @default("")
  website                    String                  @default("")
  linkedinUrl                String                  @default("")
  skills                     String[]
  lookingFor                 String[]
  openToConnect              Boolean                 @default(true)
  avatarUrl                  String                  @default("")
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  onboardingCompleted        Boolean                 @default(false)
  onboardingGoals            String[]
  onboardingStep             String?
  profileCompletion          Int                     @default(0)
  resumeFileName             String?
  resumeFileSize             Int?
  resumeKey                  String?
  resumeUpdatedAt            DateTime?
  identityVerified            Boolean                 @default(false)
  identityVerifiedAt          DateTime?
  founderVerification        FounderVerification?
  advisorProfile             AdvisorProfile?
  following                  Connection[]            @relation("Follower")
  followers                  Connection[]            @relation("Following")
  receivedConnectionRequests ConnectionRequest[]     @relation("ConnectionRequestRecipient")
  sentConnectionRequests     ConnectionRequest[]     @relation("ConnectionRequestRequester")
  conversationsA             Conversation[]          @relation("UserA")
  conversationsB             Conversation[]          @relation("UserB")
  hostedEvents               Event[]
  eventRsvps                 EventAttendee[]
  eventInvites                EventInvite[]
  communitiesOwned            Community[]             @relation("CommunityOwner")
  communityMemberships        CommunityMember[]
  founderProfile             FounderProfile?
  investorProfile            InvestorProfile?
  postedJobs                 Job[]
  jobApplications            JobApplication[]
  messagesSent               Message[]
  postsAuthored              Post[]
  postComments               PostComment[]
  postLikes                  PostLike[]
  savedPosts                 SavedPost[]
  postReports                PostReport[]
  notInterestedPosts         PostNotInterested[]
  professionalProfile        ProfessionalProfile?
  user                       User                    @relation(fields: [id], references: [id], onDelete: Cascade)
  projects                   Project[]               @relation("ProjectOwner")
  projectApplications        ProjectApplication[]
  projectMemberships         ProjectMember[]
  projectReviews             ProjectReview[]
  serviceProviderProfile     ServiceProviderProfile?
  availabilitySlots          AvailabilitySlot[]
  organizedProposals         MeetingProposal[]       @relation("ProposalOrganizer")
  proposalInvitations        ProposalInvitee[]
  meetingJoins               MeetingJoin[]
}

model FounderProfile {
  profileId     String   @id
  startupName   String   @default("")
  startupStage  String   @default("")
  industry      String[]
  pitch         String   @default("")
  fundingNeeded String   @default("")
  teamSize      String   @default("")
  website       String   @default("")
  founderStatus String   @default("")
  currentRole   String   @default("")
  goals         String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model InvestorProfile {
  profileId                String   @id
  fundName                 String   @default("")
  investmentRange          String   @default("")
  industries               String[]
  geography                String   @default("")
  portfolio                String   @default("")
  investorType             String   @default("")
  investmentStage          String[]
  yearsInvestingExperience String   @default("")
  goals                    String[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  profile                  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model AdvisorProfile {
  profileId       String   @id
  expertise       String[]
  yearsExperience String   @default("")
  industries      String[]
  mentorshipAreas String[]
  certifications  Json     @default("[]")
  experiences     Json     @default("[]")
  goals           String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  profileId          String   @id
  skills             String[]
  experienceLevel    String   @default("")
  portfolio          String   @default("")
  resume             String   @default("")
  certifications     Json     @default("[]")
  experiences        Json     @default("[]")
  goals              String[]
  specialization     String   @default("")
  specializationOther String  @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ServiceProviderProfile {
  profileId          String   @id
  company            String   @default("")
  services           String[]
  website            String   @default("")
  companyLinkedinUrl String   @default("")
  clientIndustries   String[]
  goals              String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FounderVerification {
  id              String             @id @default(uuid())
  profileId       String             @unique
  documentUrl     String
  documentKey     String
  certificateName String
  cinNumber       String             @default("")
  status          VerificationStatus @default(pending)
  reviewedBy      String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  profile         Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Connection {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Profile  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ConnectionRequest {
  id          String   @id @default(uuid())
  requesterId String
  recipientId String
  note        String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recipient   Profile  @relation("ConnectionRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  requester   Profile  @relation("ConnectionRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
}

model Project {
  id               String               @id @default(uuid())
  ownerId          String
  name             String
  tagline          String               @default("")
  description      String               @default("")
  pitch            String               @default("")
  category         String               @default("")
  industryTags     String[]
  projectType      String               @default("other")
  stage            ProjectStage         @default(idea)
  fundingStage     String               @default("bootstrapping")
  teamSize         Int                  @default(1)
  foundedYear      Int?
  location         String               @default("")
  websiteUrl       String               @default("")
  demoUrl          String               @default("")
  pitchDeckUrl     String               @default("")
  pitchVideoUrl    String               @default("")
  githubUrl        String               @default("")
  twitterUrl       String               @default("")
  linkedinUrl      String               @default("")
  logoUrl          String               @default("")
  coverUrl         String               @default("")
  techStack        String[]
  lookingFor       String[]
  isPublished      Boolean              @default(true)
  cinNumber        String               @default("")
  dpiitNumber      String               @default("")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  isVerified       Boolean              @default(false)
  isInvestorReady  Boolean              @default(false)
  investorSnapshot InvestorSnapshot?
  meetingProposals MeetingProposal[]
  posts            Post[]
  owner            Profile              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  applications     ProjectApplication[]
  members          ProjectMember[]
  reviews          ProjectReview[]
  savedBy          SavedStartup[]
  likedBy          StartupLike[]
  viewedBy         StartupView[]

  @@index([ownerId])
  @@index([stage])
  @@index([projectType])
  @@index([isPublished])
}

model SavedStartup {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model StartupLike {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model StartupView {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  viewedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model ProjectReview {
  id         String   @id @default(uuid())
  projectId  String
  reviewerId String
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer   Profile  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([projectId, reviewerId])
}

model ProjectApplication {
  id          String            @id @default(uuid())
  projectId   String
  applicantId String
  role        String            @default("")
  message     String            @default("")
  status      ApplicationStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  applicant   Profile           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, applicantId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Conversation {
  id              String    @id @default(uuid())
  userAId         String
  userBId         String
  lastMessageAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  archivedByUserA Boolean   @default(false)
  archivedByUserB Boolean   @default(false)
  userA           Profile   @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           Profile   @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  attachmentKey  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Post {
  id        String        @id @default(uuid())
  authorId  String
  content   String
  category  PostCategory  @default(Update)
  linkUrl   String        @default("")
  projectId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id])
  comments  PostComment[]
  likes     PostLike[]
  media     PostMedia[]
  savedBy   SavedPost[]
  reports   PostReport[]
  notInterestedBy PostNotInterested[]

  @@index([createdAt])
  @@index([authorId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model PostReport {
  id         String   @id @default(uuid())
  postId     String
  reporterId String
  reason     String   @default("")
  status     String   @default("open") // open | dismissed | actioned
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   Profile  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([postId])
  @@index([status])
}

model PostNotInterested {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostMedia {
  id           String            @id @default(uuid())
  postId       String
  url          String
  type         MediaType
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  width        Int?
  height       Int?
  duration     Float?
  mimeType     String?
  fileSize     Int?
  thumbnailUrl String?
  orientation  MediaOrientation?
  aspectRatio  Float?
  post         Post              @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime      @default(now())
  author    Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId])
}

model Event {
  id                 String          @id @default(uuid())
  hostId             String
  title              String
  description        String          @default("")
  location           String          @default("")
  startsAt           DateTime
  endsAt             DateTime?
  coverUrl           String          @default("")
  latitude           Float?
  longitude          Float?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  cancellationReason String?
  status             EventStatus     @default(ACTIVE)
  isPrivate          Boolean         @default(false)
  communityId        String?
  host               Profile         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  community          Community?      @relation(fields: [communityId], references: [id], onDelete: SetNull)
  attendees          EventAttendee[]
  invites            EventInvite[]

  @@index([communityId])
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventInvite {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Community {
  id          String            @id @default(uuid())
  name        String
  description String            @default("")
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       Profile           @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  events      Event[]

  @@index([ownerId])
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model ConnectedGoogleAccount {
  id               String    @id @default(uuid())
  userId           String    @unique
  googleEmail      String
  accessTokenEnc   String
  refreshTokenEnc  String
  tokenExpiresAt   DateTime
  connectedAt      DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  profileId String
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model MeetingProposal {
  id              String          @id @default(uuid())
  organizerId     String
  inviteMode      InviteMode
  targetStartupId String?
  purpose         String
  message         String?
  schedulingMode  SchedulingMode
  proposedSlots   Json?
  timezone        String?
  status          ProposalStatus  @default(pending)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organizer       Profile         @relation("ProposalOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  targetStartup   Project?        @relation(fields: [targetStartupId], references: [id])
  invitees        ProposalInvitee[]
  meeting         Meeting?

  @@index([organizerId])
  @@index([status])
}

model ProposalInvitee {
  id           String           @id @default(uuid())
  proposalId   String
  userId       String
  response     InviteeResponse  @default(pending)
  selectedSlot Json?
  respondedAt  DateTime?
  proposal     MeetingProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([userId])
}

model Meeting {
  id             String        @id @default(uuid())
  proposalId     String        @unique
  confirmedAt    DateTime
  timezone       String
  durationMins   Int           @default(30)
  meetLink       String
  googleEventId  String
  status         MeetingStatus @default(upcoming)
  cancelledBy    String?
  cancelReason   String?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  proposal       MeetingProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  reminders      MeetingReminderLog[]
  joins          MeetingJoin[]

  @@index([status])
  @@index([confirmedAt])
}

model MeetingJoin {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  joinedAt  DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
}

model MeetingReminderLog {
  id         String             @id @default(uuid())
  meetingId  String
  checkpoint ReminderCheckpoint
  sentAt     DateTime           @default(now())
  meeting    Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, checkpoint])
}

enum InviteMode {
  startup
  people
}

enum SchedulingMode {
  availability_pick
  date_push
}

enum ProposalStatus {
  pending
  confirmed
  declined
  cancelled
}

enum InviteeResponse {
  pending
  accepted
  rejected
}

enum MeetingStatus {
  upcoming
  completed
  cancelled
}

enum ReminderCheckpoint {
  t_minus_24h
  t_minus_5h
  t_minus_15m
}

model Job {
  id           String           @id @default(uuid())
  posterId     String
  startupName  String
  heading      String
  role         String           @default("")
  experience   String           @default("")
  location     String           @default("")
  openings     Int              @default(1)
  skills       String[]
  description  String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  poster       Profile          @relation(fields: [posterId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([createdAt])
}

model JobApplication {
  id             String               @id @default(uuid())
  jobId          String
  applicantId    String
  message        String               @default("")
  status         JobApplicationStatus @default(pending)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  resumeKey      String?
  resumeFileName String?
  resumeFileSize Int?
  coverLetter    String?
  expectedSalary String?
  noticePeriod   String?
  portfolioUrl   String?
  linkedinUrl    String?
  applicant      Profile              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  job            Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String
  targetId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InvestorSnapshot {
  id                       String    @id @default(uuid())
  projectId                String    @unique
  targetCustomers          String    @default("")
  businessModel            String    @default("")
  revenueStreams           String    @default("")
  marketOpportunity        String    @default("")
  totalUsers               Int?
  activeUsers              Int?
  payingCustomers          Int?
  enterpriseCustomers      Int?
  customerGrowthRate       Float?
  revenueGrowthRate        Float?
  mrr                      Float?
  arr                      Float?
  cashBalance              Float?
  burnRate                 Float?
  runwayMonths             Float?
  grossMargin              Float?
  cac                      Float?
  ltv                      Float?
  ltvCacRatio              Float?
  churnRate                Float?
  ebitda                   Float?
  ebitdaPercent            Float?
  currentRound             String    @default("")
  amountRaising            Float?
  equityOffered            Float?
  minimumCheckSize         Float?
  maximumCheckSize         Float?
  founderOwnership         Float?
  employeeEsop             Float?
  investorOwnership        Float?
  year1Revenue             Float?
  year2Revenue             Float?
  year3Revenue             Float?
  projectedCustomers       Int?
  projectedTeamSize        Int?
  breakEvenDate            DateTime?
  topRisks                 String    @default("")
  competition              String    @default("")
  operationalChallenges    String    @default("")
  regulatoryRisks          String    @default("")
  mitigationPlan           String    @default("")
  founderLinkedin          String    @default("")
  pitchDeckUrl             String    @default("")
  financialProjectionUrl   String    @default("")
