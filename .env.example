NODE_ENV=development
PORT=3000


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"


JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_POSTS=post-media
SUPABASE_BUCKET_PROJECTS=project-images
SUPABASE_BUCKET_EVENTS=event-images
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_CHAT=chat-media
SUPABASE_BUCKET_RESUMES=resumes

REDIS_HOST=localhost
REDIS_PORT=6379

# Error + performance monitoring — sentry.io > Projects > (this project) >
# Settings > Client Keys (DSN). Empty/unset disables the SDK, it doesn't error.
SENTRY_DSN=<your-sentry-dsn>

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=collaborate-media

# Meetings — Google Meet integration (see Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=<your-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://<your-api-domain>/api/google/oauth/callback
APP_OAUTH_DEEP_LINK=com.startuphouze.app://oauth-callback
OAUTH_STATE_SECRET=<generate-a-long-random-secret>

# Encrypts stored Google OAuth tokens at rest — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=<generate-a-32-byte-random-secret>

# Transactional email (password reset, signup confirmation) — resend.com, free up to 3,000/month.
# Without a verified sending domain, Resend only delivers to the email you signed up to Resend with.
RESEND_API_KEY=<your-resend-api-key>
MAIL_FROM=Orbit <onboarding@resend.dev>
# Must match app.json's "scheme" and the prefixes registered in linking.ts —
# these are React-Navigation-routed deep links, unlike the Google OAuth
# callback which is caught by a raw Linking listener instead.
APP_RESET_PASSWORD_DEEP_LINK=startuphouze://reset-password
APP_VERIFY_EMAIL_DEEP_LINK=startuphouze://verify-email

# Profile verification — identity check via DigiLocker Partner API. Register Orbit as a
# Requester organization at api.digitallocker.gov.in to get these; identity verification
# returns a clear "not configured" error to the app until they're filled in.
DIGILOCKER_CLIENT_ID=<your-digilocker-partner-client-id>
DIGILOCKER_CLIENT_SECRET=<your-digilocker-partner-client-secret>
DIGILOCKER_REDIRECT_URI=https://<your-api-domain>/api/verification/identity/callback
APP_DIGILOCKER_DEEP_LINK=startuphouze://verify-identity

# Phone OTP verification — Twilio Verify (Console > Verify > Services for the
# service SID; Console > Account > API keys & tokens for an API Key SID/Secret
# pair, safer to hand a backend than the raw Account Auth Token since it can be
# revoked independently). Sending SMS to Indian numbers additionally requires
# DLT (TRAI) registration — separate from Twilio — or messages get blocked.
# Returns a clean "not configured" error to the app until these are filled in.
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_API_KEY_SID=<your-twilio-api-key-sid>
TWILIO_API_KEY_SECRET=<your-twilio-api-key-secret>
TWILIO_VERIFY_SERVICE_SID=<your-twilio-verify-service-sid>
