NODE_ENV=development
PORT=3000


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"


JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_POSTS=post-media
SUPABASE_BUCKET_PROJECTS=project-images
SUPABASE_BUCKET_EVENTS=event-images
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_CHAT=chat-media
SUPABASE_BUCKET_RESUMES=resumes

REDIS_HOST=localhost
REDIS_PORT=6379

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=collaborate-media
