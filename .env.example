NODE_ENV=development
PORT=3000


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"


JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_POSTS=post-media
SUPABASE_BUCKET_PROJECTS=project-images
SUPABASE_BUCKET_EVENTS=event-images
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_CHAT=chat-media
SUPABASE_BUCKET_RESUMES=resumes

REDIS_HOST=localhost
REDIS_PORT=6379

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=collaborate-media

# Meetings — Google Meet integration (see Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=<your-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://<your-api-domain>/api/google/oauth/callback
APP_OAUTH_DEEP_LINK=com.startuphouze.app://oauth-callback
OAUTH_STATE_SECRET=<generate-a-long-random-secret>

# Encrypts stored Google OAuth tokens at rest — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=<generate-a-32-byte-random-secret>

# Transactional email (password reset, signup confirmation) — resend.com, free up to 3,000/month.
# Without a verified sending domain, Resend only delivers to the email you signed up to Resend with.
RESEND_API_KEY=<your-resend-api-key>
MAIL_FROM=Orbit <onboarding@resend.dev>
# Must match app.json's "scheme" and the prefixes registered in linking.ts —
# these are React-Navigation-routed deep links, unlike the Google OAuth
# callback which is caught by a raw Linking listener instead.
APP_RESET_PASSWORD_DEEP_LINK=startuphouze://reset-password
APP_VERIFY_EMAIL_DEEP_LINK=startuphouze://verify-email
